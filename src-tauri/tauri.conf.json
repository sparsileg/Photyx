{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "photyx",
  "identifier": "com.sparsile.photyx",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Photyx",
        "width": 1700,
        "height": 1400,
        "x": 700,
        "y": 100,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/docs/**"]
      }
    }
  },
  "plugins": {
    "dialog": null
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": { "resources/docs/": "docs/" },
    "targets": ["deb", "rpm", "appimage", "nsis", "app", "dmg"]
  }
}
